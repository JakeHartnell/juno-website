{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juno.network/schemas/defi-v1-pool-registry.schema.json",
  "title": "Juno DeFi v1 Pool Registry",
  "description": "Minimal registry shape for the first Juno DEX UI: swaps, pools, and liquidity only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["chainId", "factory", "pools"],
  "properties": {
    "chainId": {
      "type": "string",
      "const": "juno-1",
      "description": "Cosmos chain ID for the registry. Use a separate file for testnet."
    },
    "factory": {
      "$ref": "#/$defs/junoAddress",
      "description": "Astroport-style factory contract used for pair discovery."
    },
    "router": {
      "$ref": "#/$defs/junoAddress",
      "description": "Optional router contract. Leave absent until direct pool swaps are verified."
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Last manual verification timestamp."
    },
    "pools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "pair", "lpToken", "type", "assets"],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 3,
            "examples": ["JUNO / USDC"]
          },
          "pair": {
            "$ref": "#/$defs/junoAddress",
            "description": "Pair contract address."
          },
          "lpToken": {
            "oneOf": [
              { "$ref": "#/$defs/junoAddress" },
              { "$ref": "#/$defs/ibcDenom" },
              { "$ref": "#/$defs/nativeDenom" }
            ],
            "description": "LP token address or denom, depending on deployment."
          },
          "type": {
            "type": "string",
            "enum": ["xyk", "stable"],
            "description": "Keep v1 focused on constant product first; stable pools only if already deployed."
          },
          "feeBps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "description": "Swap fee in basis points if known."
          },
          "assets": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "description": "Exactly two distinct asset IDs. The validator enforces no duplicate side of a pool.",
            "items": {
              "$ref": "#/$defs/asset"
            }
          },
          "explorer": {
            "type": "string",
            "format": "uri",
            "description": "Explorer URL for the pair contract."
          },
          "notes": {
            "type": "string",
            "description": "Short human verification note; no secrets."
          }
        }
      }
    }
  },
  "$defs": {
    "junoAddress": {
      "type": "string",
      "pattern": "^juno1[0-9a-z]{38,58}$"
    },
    "nativeDenom": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9/:._-]{2,127}$",
      "examples": ["ujuno"]
    },
    "ibcDenom": {
      "type": "string",
      "pattern": "^ibc/[A-F0-9]{64}$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "symbol", "decimals"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["native", "ibc", "cw20"]
        },
        "id": {
          "oneOf": [
            { "$ref": "#/$defs/nativeDenom" },
            { "$ref": "#/$defs/ibcDenom" },
            { "$ref": "#/$defs/junoAddress" }
          ]
        },
        "symbol": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        }
      }
    }
  }
}
